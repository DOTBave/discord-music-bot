# 必填
DISCORD_TOKEN=your_discord_bot_token_here
GEMINI_API_KEY=your_gemini_api_key_here

# 可选：deno 路径（留空则自动从 PATH 查找；路径失效也会自动回退）
# DENO=/usr/local/bin/deno

# Gemini 系统提示词
# GEMINI_PROMPT="You're a helpful assistant. Respond in at most 3 sentences."

# 可选：yt-dlp 相关
# COOKIES_FILE=cookies.txt
# YOUTUBE_CLIENTS=android_vr,mweb
# YTDLP_VERBOSE=0
# FFMPEG_PATH=ffmpeg
